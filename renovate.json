{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>harunonsystem/.github:renovate-config",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separateMajorReleases"
  ],
  "packageRules": [
    {
      "groupName": "vitest packages",
      "matchPackageNames": ["/^vitest$/", "/^@vitest//"],
      "schedule": ["before 3am on Monday"]
    },
    {
      "groupName": "GitHub Actions dependencies",
      "matchPackageNames": ["/^@actions//"],
      "schedule": ["before 3am on Monday"]
    },
    {
      "description": "@vercel/ncc's ts-loader needs the JS compiler API that TypeScript 7 removed; lift once ncc supports it",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "assignees": ["@harunonsystem"]
  },
  "labels": ["dependencies"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 3am on Monday"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "commitMessagePrefix": "chore(deps):",
  "semanticCommits": "enabled",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on the first day of the month"]
  }
}
