{
  "name": "cf-workers-actions",
  "version": "1.3.2",
  "private": true,
  "description": "GitHub Actions for Cloudflare Workers deployment, PR commenting, and cleanup",
  "keywords": [
    "cloudflare",
    "deployment",
    "github-actions",
    "preview",
    "workers"
  ],
  "license": "MIT",
  "author": "harunonsystem",
  "main": "index.js",
  "scripts": {
    "build": "pnpm run clean:dist && node scripts/build.mjs",
    "build:watch": "tsc --watch",
    "clean:dist": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run format:check && pnpm run lint && pnpm test",
    "prepare": "pnpm run build",
    "version": "pnpm run build && git add dist/"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=12.15.0"
  },
  "packageManager": "pnpm@12.15.0"
}
